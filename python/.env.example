# ============================================================
# AidenOps AgentSwarm - LLM Provider Configuration
# ============================================================

# Keep deterministic for offline development and CI.
#
# Supported:
#   deterministic
#   nvidia
#   openrouter
#   openai
#   anthropic
#   google
#   azure_openai
AGENT_LLM_PROVIDER=deterministic

# Optional common model override.
# If empty, the provider-specific model variable is used.
AGENT_LLM_MODEL=

# ============================================================
# NVIDIA NIM
# ============================================================

NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=moonshotai/kimi-k3
NVIDIA_NIM_TIMEOUT_SECONDS=60
NVIDIA_NIM_API_KEY=

# ============================================================
# OpenRouter
# ============================================================

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_API_KEY=

# Optional OpenRouter metadata.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=AidenOps AgentSwarm

# ============================================================
# OpenAI
# ============================================================

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_API_KEY=

# ============================================================
# Anthropic
# ============================================================

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_API_KEY=

# ============================================================
# Google Gemini
# Uses Google's OpenAI-compatible endpoint.
# ============================================================

GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_MODEL=gemini-3.8-flash
GOOGLE_TIMEOUT_SECONDS=60
GOOGLE_API_KEY=

# ============================================================
# Azure OpenAI
# ============================================================

# Example:
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Optional complete endpoint override:
# AZURE_OPENAI_BASE_URL=https://my-resource.openai.azure.com/openai/v1
AZURE_OPENAI_BASE_URL=

# Azure deployment/model name.
AZURE_OPENAI_MODEL=
AZURE_OPENAI_TIMEOUT_SECONDS=60
AZURE_OPENAI_API_KEY=