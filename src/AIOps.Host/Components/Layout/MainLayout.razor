@inherits LayoutComponentBase

@inject AIOps.Abstractions.Integrations.ICloudProviderStatusService CloudProviderStatusService
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ISnackbar Snackbar

@{
    var cloudProviderStatus = CloudProviderStatusService.GetStatus();
    var cloudProviderLabel = cloudProviderStatus.IsProduction
        ? $"{cloudProviderStatus.DisplayName} — REAL"
        : cloudProviderStatus.DisplayName.ToUpperInvariant();
    var cloudProviderColor = cloudProviderStatus.IsProduction
        ? Color.Error
        : Color.Success;
}

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="aiden-shell">
    <MudAppBar Elevation="0" Class="aiden-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" OnClick="ToggleDrawer" Class="aiden-menu-button" aria-label="Toggle navigation" />
        <div class="aiden-brand"><div class="aiden-mark"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></div><div><MudText Typo="Typo.subtitle1" Class="aiden-brand-name">AidenOps</MudText><div class="aiden-brand-caption">AI OPERATIONS CONTROL PLANE</div></div></div>
        <MudSpacer />
        <div class="aiden-statuses">
        <MudChip T="string" Color="@cloudProviderColor" Variant="Variant.Outlined" Size="Size.Small" Class="aiden-status-chip">
            CLOUD · @cloudProviderLabel
        </MudChip>
        @if (_itsmStatus is not null)
        {
            <MudChip T="string" Color="@ItsmStatusColor" Variant="Variant.Outlined" Size="Size.Small" Class="aiden-status-chip">
                @ItsmHeaderLabel
            </MudChip>
        }
        </div>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Elevation="0" Class="aiden-drawer">
        <div class="drawer-heading"><span>WORKSPACE</span><MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">GOVERNED</MudChip></div>
        <MudNavMenu Class="aiden-drawer-nav">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
            <MudNavLink Href="/integrations" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Hub">Integrations</MudNavLink>
            <MudNavLink Href="/demo" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.PlayCircle">Guided demo</MudNavLink>
        </MudNavMenu>
        <div class="drawer-footer"><MudIcon Icon="@Icons.Material.Filled.VerifiedUser" /><div><div class="drawer-footer-title">Server authority</div><div class="drawer-footer-copy">Policy · approval · audit</div></div></div>
    </MudDrawer>
    <MudMainContent Class="aiden-main">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AIOps.Abstractions.Integrations.ItsmProviderStatus? _itsmStatus;
    private Microsoft.JSInterop.IJSObjectReference? _itsmApi;
    private bool _drawerOpen = true;
    private string ItsmConnectionLabel => _itsmStatus?.ConnectionStatus switch
    {
        "NotConfigured" => "Not Configured",
        "Unavailable" => "Unavailable",
        "Connected" => "Connected",
        "Simulated" => "Simulated",
        _ => "Unavailable"
    };
    private Color ItsmStatusColor => ItsmConnectionLabel switch
    {
        "Simulated" => Color.Success,
        "Connected" => Color.Success,
        "Not Configured" => Color.Warning,
        _ => Color.Error
    };
    private string ItsmHeaderLabel => _itsmStatus?.Mode == "Simulated"
        ? "ITSM: SIMULATED"
        : $"ITSM: {_itsmStatus?.DisplayName.ToUpperInvariant()} · {ItsmConnectionLabel.ToUpperInvariant()}";
    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _itsmApi = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>(
                "import", "./Components/Layout/MainLayout.razor.js");
            _itsmStatus = await _itsmApi.InvokeAsync<AIOps.Abstractions.Integrations.ItsmProviderStatus>(
                "getItsmProviderStatus");
        }
        catch
        {
            Snackbar.Add("ITSM provider status is unavailable.", Severity.Warning);
        }

        StateHasChanged();
    }
}
