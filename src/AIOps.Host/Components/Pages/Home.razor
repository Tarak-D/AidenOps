@page "/"

<PageTitle>AIOps Agent Platform</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Autonomous IT Operations Agent Platform</MudText>
<MudText Typo="Typo.subtitle1" Class="mb-6">
    Multi-agent AI triage, investigation, and resolution of IT support tickets —
    .NET 10 + Orleans control plane, Python/LangGraph agent layer (Phase 5+).
</MudText>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
    <b>Phase 1 complete:</b> solution skeleton, domain model, platform abstractions,
    security policies, and dev infrastructure are in place. Agent workflows activate from Phase 5.
</MudAlert>

<MudGrid>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Control Plane</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudText>.NET 10 ASP.NET Core, Orleans co-hosted silo (in-memory grain storage in dev), SignalR hub at <code>/hubs/tickets</code>.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">AI Agent Layer</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudText>LangGraph multi-agent workflow behind <code>IAgentGateway</code> (currently a deterministic fake).
                Kimi K3 via NVIDIA NIM — key configured via user-secrets/env only.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudCard Elevation="2">
            <MudCardHeader><CardHeaderContent><MudText Typo="Typo.h6">Governance</MudText></CardHeaderContent></MudCardHeader>
            <MudCardContent>
                <MudText>Sensitive actions require human approval. All actions are simulated. Audit is append-only by design.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudText Typo="Typo.body2" Class="mt-6" Color="Color.Secondary">
    Ops endpoints: <code>/health</code>, <code>/api/v1/meta/selfcheck</code>, <code>/api/v1/meta/config</code>
</MudText>
