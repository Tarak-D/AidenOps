{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Orleans": "Warning"
      }
    }
  },

  "AI": {
    "AgentGatewayMode": "Fake",

    "AgentService": {
      "BaseUrl": "http://127.0.0.1:8000/",
      "TimeoutSeconds": 60
    },

    "NvidiaNim": {
      "BaseUrl": "https://integrate.api.nvidia.com/v1",
      "Model": "moonshotai/kimi-k3",
      "ApiKey": ""
    }
  },

  "Approvals": {
    "DefaultTtl": "1.00:00:00"
  },

  "AgentPolicy": {
    "TriageConfidenceThreshold": 0.6,
    "MaxAttempts": 2
  },

  "Integrations": {
    "Cloud": {
      "Provider": "Simulated",
      "TimeoutSeconds": 30
    },
    "Directory": {
      "Provider": "Simulated",
      "TimeoutSeconds": 30
    },
      "Itsm": {
        "Provider": "Simulated",
        "TimeoutSeconds": 30,
        "ServiceNow": {
          "BaseUrl": "",
          "ClientId": "",
          "ClientSecret": ""
        },
        "JiraServiceManagement": {
          "BaseUrl": "",
          "Email": "",
          "ApiToken": "",
          "ProjectKey": "",
          "IssueType": "",
          "TimeoutSeconds": 30,
          "StateMappings": {
            "Open": "Open",
            "InProgress": "In Progress",
            "Resolved": "Resolved",
            "Closed": "Closed"
          }
        },
        "Zendesk": {
          "BaseUrl": "",
          "Email": "",
          "ApiToken": "",
          "TimeoutSeconds": 30
        }
      }
  },

  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=aios;Username=aios;Password=aiospw"
  },

  "AllowedHosts": "*"
}
